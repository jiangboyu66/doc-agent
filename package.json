{
  "name": "doc-agent",
  "version": "2.7.1",
  "description": "文案 Agent：基于 DeepSeek 的文档编辑 Agent。Word 原生 OOXML 引擎，未修改内容字节级保真；架构对标 Claude Code 源码中的设计理念。",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/entrypoints/server.ts",
    "start": "tsx src/entrypoints/server.ts",
    "cli": "tsx src/entrypoints/cli.ts",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.4",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.16",
    "openai": "^7.23.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^4.10.38",
    "prompts": "^2.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
