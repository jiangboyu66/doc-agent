# DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-在这里填写你的key

# 模型：deepseek-flash（快、便宜，默认）或 deepseek-v4-pro（更强）
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：enabled / disabled
DEEPSEEK_THINKING=enabled
# 思考强度：low / high / max（可选）
# DEEPSEEK_REASONING_EFFORT=high
# 自定义接口地址（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web 端口
PORT=3939

# 外部工具路径（不在 PATH 中时填写；Windows 示例）
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# PANDOC_PATH=C:\Program Files\Pandoc\pandoc.exe

# 修订与批注的默认作者
# DOC_AGENT_AUTHOR=文案 Agent
# 开关功能（逗号分隔），如关闭子代理：DOC_AGENT_DISABLE=SUBAGENTS
# DOC_AGENT_DISABLE=
